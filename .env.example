APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_MAX_REQUEST_SIZE_BYTES=65536
APP_MAX_MESSAGE_CHARS=4000
APP_REQUEST_TIMEOUT_SECONDS=60

MODEL_BACKEND=litellm
DEFAULT_MODEL_ALIAS=fast
MODEL_CONFIG_PATH=litellm.yaml
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_TOKENS=4096
MODEL_CATALOG_TIMEOUT_SECONDS=10
DYNAMIC_MODEL_CONFIG_PATH=data/models.json
HEALTHCHECK_TIMEOUT_SECONDS=3

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
REASONING_MODEL_ID=qwen/qwen3-next-80b-a3b-thinking
OPENROUTER_API_KEY=
# Use any current model ID ending in :free, or keep openrouter/free for automatic routing.
OPENROUTER_FREE_MODEL_ID=openrouter/free
HF_TOKEN=

STATE_BACKEND=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_ai_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
FILESYSTEM_MCP_ALLOWED_ROOT=.
GOVERNANCE_CONFIG_PATH=data/governance.json
NEWS_RSS_FEEDS=
NEWS_TIMEOUT_SECONDS=8
NEWS_MAX_ITEMS=5
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-local-development-project
LANGFUSE_SECRET_KEY=sk-lf-local-development-project
LANGFUSE_BASE_URL=http://localhost:3000
